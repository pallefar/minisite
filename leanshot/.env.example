# LeanShot environment variables — Vite injects all VITE_-prefixed vars at build time.
# Copy to .env.local for local dev (.env.local is gitignored).
# In production: set these in your hosting provider's env config.

# =============================================================================
# Phase 1 — runtime telemetry (Sentry + PostHog)
# Source: 01-CONTEXT.md D-09 (Sentry redaction), D-13 (PostHog cookieless),
#         D-15 (dormant until prod)
# =============================================================================

# Sentry — error tracking (PROD-02). Leave empty in dev to silence Sentry init (no-op).
#
# DSN routing per 16-CONTEXT-ADDENDUM-sentry-per-platform-projects.md
# (supersedes D-17 single-project decision 2026-05-16): three separate Sentry
# projects under org `optimizenet` on de.sentry.io. Set the per-platform var
# at BUILD TIME for the matching target — fastlane (Plan 16-09) sets
# VITE_SENTRY_DSN_IOS for iOS jobs and VITE_SENTRY_DSN_ANDROID for Android
# jobs; Vercel sets VITE_SENTRY_DSN_WEB for the marketing/SPA deploy.
#
# VITE_SENTRY_DSN (no suffix) stays as a legacy safety fallback consumed by
# both web and native paths when the per-platform override is unset.
VITE_SENTRY_DSN_WEB=
VITE_SENTRY_DSN_IOS=
VITE_SENTRY_DSN_ANDROID=
VITE_SENTRY_DSN=

# Sentry release tag — per D-17 the shape is `<platform>@<version>`:
#   - Web build:     leave blank or set to `web@<package-version>` (web emits
#                    web events into the same project; the absence of a tag is
#                    treated as "untagged web").
#   - iOS build:     `ios@<CFBundleShortVersionString>` (wired by fastlane in Plan 16-09).
#   - Android build: `android@<versionName>` (wired by fastlane in Plan 16-09).
# Plan 16-04 reads this at runtime (`import.meta.env.VITE_SENTRY_RELEASE`) and
# passes it to `initSentryNative({...release})` on native platforms only.
VITE_SENTRY_RELEASE=

# PostHog — cookieless product analytics (PROD-03)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# PRODUCTION: leave VITE_ANALYTICS_ENABLED=false until Phase 7 legal-counsel sign-off
# (WMHMDA / FTC HBNR review per Pitfall 5). Setting to 'true' in production starts
# the WMHMDA compliance clock.
# In dev/QA, set to 'true' so the founder can verify the PostHog dashboard wiring.
VITE_ANALYTICS_ENABLED=false

# =============================================================================
# Phase 2 — build-time Sentry source-map upload (Vercel Production ONLY)
# Source: 02-CONTEXT.md D-20 (blocking upload), D-22 (Preview skips)
# These are READ AT BUILD TIME by @sentry/vite-plugin. NEVER prefix with VITE_ —
# build-time secrets must not be exposed to the browser bundle.
# Set only in Vercel "Production" env. Preview + Development leave unset.
# =============================================================================

# Sentry org auth token with `project:releases` + `project:read` + `org:read` scopes.
# See: https://docs.sentry.io/account/auth-tokens/
SENTRY_AUTH_TOKEN=

# Sentry org slug (the URL fragment, e.g. 'leanshot').
SENTRY_ORG=

# Sentry project slug (e.g. 'javascript-react').
SENTRY_PROJECT=

# =============================================================================
# Phase 2 — Vercel-injected (DO NOT SET MANUALLY; provided automatically by Vercel)
# =============================================================================
# VERCEL_GIT_COMMIT_SHA — used as the Sentry release tag (D-21). Vercel auto-populates.

# =============================================================================
# Phase 8 — Doctor read-share Edge Function origin (ME-3)
# Source: 08-04-PLAN.md ME-3 — override the Supabase Functions origin used by
#         src/components/share/share-client.ts.
# =============================================================================

# Override the Supabase Functions origin used by the doctor share client.
# When unset, the share client defaults to `${VITE_SUPABASE_URL}/functions/v1`.
# Useful for pointing local dev at a deployed functions instance or vice versa.
VITE_SUPABASE_FUNCTIONS_URL=

# =============================================================================
# Phase 14 — Stripe monetization (MONEY-01..05, 08, 09)
# Source: 14-CONTEXT.md D-09 (web pricing), D-10 (clinic pricing), D-11
#         (bootstrap script), D-16 (CSP additions); 14-RESEARCH.md §"Bootstrap
#         script" lines 523-585.
# Fill in STRIPE_PRICE_* + STRIPE_METER_* after running:
#   cd leanshot && STRIPE_SECRET_KEY=sk_test_... npx tsx scripts/stripe-bootstrap.ts
# Then copy the stdout block into .env.local + Vercel env + Supabase Function
# secrets (per [[feedback_cli_over_paste_back]] — Stripe MCP-fetchable).
# NEVER prefix STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET with VITE_ —
# server-only secrets must not enter the browser bundle.
# =============================================================================

# Stripe API secret key (server-only — Edge Functions + bootstrap script)
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (server-only — supabase/functions/stripe-webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe publishable key (BROWSER-safe — only Phase 14 var with VITE_ prefix).
# Today: unused (Upgrade CTA uses plain `window.location.href` per Pitfall 10
# to keep @stripe/stripe-js out of the bundle). Reserved for a future plan
# that opts into Stripe.js for embedded Payment Element flows.
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Price IDs — filled after running scripts/stripe-bootstrap.ts (D-09 + D-10).
# Web tier ($12.99/mo, $132.49/yr — 15% off):
STRIPE_PRICE_PLUS_MONTHLY=price_...
STRIPE_PRICE_PLUS_YEARLY=price_...
# Clinic tier ($99/mo base + $9/active-patient overage, metered):
STRIPE_PRICE_CLINIC_BASE=price_...
STRIPE_PRICE_CLINIC_OVERAGE=price_...

# Billing Meter ID for clinic active-patient overage (mtr_xxx) — D-10 / RESEARCH §"Billing Meters".
STRIPE_METER_ACTIVE_PATIENTS=mtr_...

# =============================================================================
# Phase 53 — RevenueCat client SDK keys (MOBILE-06 client half)
# Source: 53-02-PLAN.md; iap.ts bridge reads these at module-init time.
#
# These are RevenueCat PUBLIC SDK keys (designed to be embedded in the app
# bundle — VITE_-prefix is correct per iap.ts threat-model comment T-53-04).
# The configureRC() bridge in src/lib/native/iap.ts reads them at module-init
# time via import.meta.env and passes them to Purchases.configure() on iOS
# and Android. On web, configureRC() is a no-op and these values are unused.
#
# Real values are pending-provisioning: they will be filled when RevenueCat
# projects are created during Phase 70 (smoke-tracked in the Phase 52 vendor
# dashboard). Leave empty in dev until Phase 70.
#
# SERVER-ONLY NOTE: REVENUECAT_WEBHOOK_SECRET and REVENUECAT_WEBHOOK_AUTH are
# NOT declared here — they are server-only Supabase Function Secrets documented
# in supabase/functions/revenuecat-webhook/SECRETS-RUNBOOK.md (owned by 53-04).
# DO NOT add a VITE_-prefixed webhook secret.
# =============================================================================

# RevenueCat PUBLIC SDK key for iOS (read by iap.ts::configureRC on platform=ios).
# Set at Phase 70 using the iOS app key from the RevenueCat dashboard.
VITE_RC_API_KEY_IOS=

# RevenueCat PUBLIC SDK key for Android (read by iap.ts::configureRC on platform=android).
# Set at Phase 70 using the Android app key from the RevenueCat dashboard.
VITE_RC_API_KEY_ANDROID=
