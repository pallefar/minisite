; Phase 16 Plan 16-04 escape hatch — @sentry/capacitor@4.0.0 peer-pins
; @sentry/react@10.43.0, but the project uses @sentry/react@^10.52.0 (15
; prior phases of code paths). Downgrading would be a Rule-4 architectural
; change; instead we accept the structural-identity bridge cast at the
; init call boundary (see src/lib/sentry-native.ts) and tell npm to skip
; peer-dep enforcement on install. Verified via [[reference-npm-sentry-capacitor-peer-conflict]].
;
; This flag MUST apply in CI (Vercel npm install) just as it does locally
; — without it Vercel builds fail with ERESOLVE on @sentry/react peer
; (caught after 4 silent Vercel deploy failures 2026-05-16 09:01–11:00 UTC
; before the regression was attributed to the missing CI-side flag).
legacy-peer-deps=true
