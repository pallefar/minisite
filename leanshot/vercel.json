{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps --update-sentry-capacitor",
  "redirects": [
    { "source": "/signin", "destination": "https://app.leanshot.app/#/auth/signin", "permanent": false },
    { "source": "/signup", "destination": "https://app.leanshot.app/#/auth/signup", "permanent": false },
    { "source": "/reset-password", "destination": "https://app.leanshot.app/#/auth/set-new-password", "permanent": false },
    { "source": "/verify-email", "destination": "https://app.leanshot.app/#/auth/verify", "permanent": false },
    { "source": "/legal/:slug", "destination": "https://app.leanshot.app/#/legal/:slug", "permanent": false }
  ],
  "rewrites": [
    { "source": "/r/:code", "destination": "https://ytnsipxxmzgaebkqmokp.supabase.co/functions/v1/affiliate-attribute?code=:code" },
    { "source": "/api/calendly/oauth-start", "destination": "https://ytnsipxxmzgaebkqmokp.supabase.co/functions/v1/calendly-oauth-start" },
    { "source": "/api/calendly/oauth-callback", "destination": "https://ytnsipxxmzgaebkqmokp.supabase.co/functions/v1/calendly-oauth-callback" },
    { "source": "/clinic/(.*)", "destination": "/index.html" },
    { "source": "/clinic-invite/(.*)", "destination": "/index.html" },
    { "source": "/affiliate", "destination": "/index.html" },
    { "source": "/partner/(.*)", "destination": "/index.html" },
    { "source": "/admin/affiliates", "destination": "/index.html" },
    { "source": "/api/og/(.*)", "destination": "/api/og/$1" },
    { "source": "/share/level/(.*)", "destination": "/api/share/level/$1" },
    { "source": "/share/(.*)", "destination": "/index.html" },
    { "source": "/sitemap.xml", "has": [{ "type": "host", "value": "leanshot.app" }], "destination": "https://ytnsipxxmzgaebkqmokp.supabase.co/functions/v1/sitemap" },
    { "source": "/((?!clinic|clinic-invite|admin|share|api|auth|assets|index\\.html|assets/|sitemap\\.xml|robots\\.txt|partner|affiliate|r|\\.well-known|signin|signup|reset-password|verify-email|legal).+)", "has": [{ "type": "host", "value": "leanshot.app" }], "destination": "https://ytnsipxxmzgaebkqmokp.supabase.co/functions/v1/page-render?slug=$1" },
    { "source": "/((?!assets|api|\\.well-known|favicon|robots\\.txt).+)", "has": [{ "type": "host", "value": "app.leanshot.app" }], "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/api/lead-capture",
      "headers": [
        { "key": "X-RateLimit-Policy", "value": "30/min per-IP (Phase 67-02 OPS-03; enforced by leanshot/middleware.ts)" }
      ]
    },
    {
      "source": "/api/og/(.*)",
      "headers": [
        { "key": "X-RateLimit-Policy", "value": "60/min per-IP (Phase 67-02 OPS-03; enforced by leanshot/middleware.ts)" }
      ]
    },
    {
      "source": "/api/affiliate-impression",
      "headers": [
        { "key": "X-RateLimit-Policy", "value": "10/min per-IP (Phase 67-02 OPS-03; enforced by leanshot/middleware.ts)" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; manifest-src 'self'; script-src 'self' https://js.stripe.com https://assets.calendly.com https://www.youtube-nocookie.com https://s.ytimg.com https://tally.so; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.ingest.us.sentry.io https://*.ingest.sentry.io https://*.posthog.com https://api.anthropic.com https://api.stripe.com https://m.stripe.network https://api.calendly.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://i.ytimg.com https://*.supabase.co https://leanshot.app; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://calendly.com https://*.calendly.com https://www.youtube-nocookie.com https://youtube-nocookie.com https://tally.so https://*.tally.so; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; worker-src 'self' blob:" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
